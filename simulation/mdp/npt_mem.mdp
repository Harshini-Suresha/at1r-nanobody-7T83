; NPT equilibration, semiisotropic (membrane / 8TH3 complex)
integrator       = md
dt               = 0.001
nsteps           = 500000       ; 500 ps

nstxout          = 0
nstvout          = 0
nstfout          = 0
nstlog           = 5000
nstxout-compressed = 5000

continuation     = yes
constraint_algorithm = h-bonds
constraints      = all-bonds

define           = -DPOSRES

gen_vel          = no

cutoff-scheme    = Verlet
pbc              = xyz
coulombtype      = pme
rcoulomb         = 1.2
vdwtype          = cutoff
rvdw             = 1.2
vdw-modifier     = potential-shift
DispCorr         = no

tcoupl           = v-rescale
tc-grps          = Protein POPC SOL_ions
tau_t            = 1.0 1.0 1.0
ref_t            = 310 310 310
pcoupl           = C-rescale
pcoupltype       = semiisotropic
tau_p            = 5.0
ref_p            = 1.0 1.0
compressibility  = 3.0e-4 3.0e-4
refcoord_scaling = com

comm_mode        = linear
nstcomm          = 100